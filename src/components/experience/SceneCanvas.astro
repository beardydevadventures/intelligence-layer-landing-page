<div class="scene-shell" aria-hidden="true">
  <canvas id="intelligence-scene"></canvas>
  <div class="scene-fallback"><img src="/brand/intelligence-layer-mark-flat.svg" width="370" height="410" alt="" /></div>
</div>
<script>
  const canvas = document.querySelector<HTMLCanvasElement>('#intelligence-scene');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const mobile = matchMedia('(max-width: 700px)');
  let scene: import('./IntelligenceLayerScene').IntelligenceLayerScene | undefined;
  let starting = false;
  const update = async () => {
    if (!canvas) return;
    if (reduce.matches || mobile.matches) {
      scene?.destroy(); scene=undefined;
      document.documentElement.classList.remove('scene-ready');
      return;
    }
    if (scene || starting) return;
    starting=true;
    try {
      const {IntelligenceLayerScene} = await import('./IntelligenceLayerScene');
      if (reduce.matches || mobile.matches) return;
      scene=new IntelligenceLayerScene(canvas);
      canvas.addEventListener('webglcontextlost',()=>{scene?.destroy();scene=undefined;document.documentElement.classList.remove('scene-ready');},{once:true});
      document.documentElement.classList.add('scene-ready');
    } catch {document.documentElement.classList.add('scene-failed');}
    finally {starting=false;}
  };
  reduce.addEventListener('change',update); mobile.addEventListener('change',update);
  addEventListener('pagehide',()=>{scene?.destroy();scene=undefined;document.documentElement.classList.remove('scene-ready');});
  addEventListener('pageshow',update);
  if ('requestIdleCallback' in window) window.requestIdleCallback(update,{timeout:1200});
  else setTimeout(update,80);
</script>
