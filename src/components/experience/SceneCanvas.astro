<div class="scene-shell" aria-hidden="true">
  <canvas id="intelligence-scene"></canvas>
  <div class="scene-fallback"><i></i><i></i><i></i><i></i><i></i></div>
</div>
<script>
  const canvas = document.querySelector<HTMLCanvasElement>('#intelligence-scene');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (canvas && !reduce) {
    const start = async () => {
      try {
        const { IntelligenceLayerScene } = await import('./IntelligenceLayerScene');
        // WebGPU is attempted only on capable browsers; WebGL remains the dependable baseline.
        let renderer;
        if ('gpu' in navigator) {
          try {
            const { WebGPURenderer } = await import('three/webgpu');
            const candidate = new WebGPURenderer({ canvas, antialias: true, alpha: true });
            await candidate.init();
            renderer = candidate;
          } catch { /* Fall through to WebGL. */ }
        }
        new IntelligenceLayerScene(canvas, renderer);
        document.documentElement.classList.add('scene-ready');
      } catch { document.documentElement.classList.add('scene-failed'); }
    };
    if ('requestIdleCallback' in window) window.requestIdleCallback(start, { timeout: 1200 });
    else setTimeout(start, 80);
  }
</script>
