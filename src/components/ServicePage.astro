---
import SiteLayout from '../layouts/SiteLayout.astro';
import SceneCanvas from './experience/SceneCanvas.astro';
import ProjectCard from './ProjectCard.astro';
import ContactSection from './ContactSection.astro';
import RelatedContent from './RelatedContent.astro';
import {getContent} from '../lib/sanity/content';
import {pageSeo, breadcrumbs} from '../lib/sanity/seo';
import {site} from '../data/site';
import type {Service} from '../lib/sanity/types';
interface Props {service: Service}
const {service} = Astro.props;
const {settings} = await getContent();
const path = `/${service.category}/${service.slug}/`;
const vr = path === '/xr/vr-development/';
const words = service.headline.split(' ');
const firstWords = words.slice(0,-1).join(' '), lastWord = words.slice(-1).join(' ');
---
<SiteLayout {...pageSeo(service.seo, settings, `${service.title} Brisbane & Australia | ${settings.companyName}`, service.introduction || service.shortDescription, path)} schema={[{'@type':'Service','@id':`${site.url}${path}#service`, name:service.title, serviceType:service.title, description:service.shortDescription, provider:{'@id':`${site.url}/#organisation`}, areaServed:{'@type':'Country',name:'Australia'}, url:`${site.url}${path}`}, breadcrumbs([{name:'Home',path:'/'},{name:service.title,path}])]}>
<SceneCanvas /><main id="main" class="service-page">
<section class="hero section-grid" id="top" data-scene={service.category === 'xr' ? 'spatial' : 'automation'}><div class="content content-wide"><p class="eyebrow"><a href="/">Home</a> / {service.category.toUpperCase()} / {service.title}</p><h1>{firstWords} <em>{lastWord}</em></h1><p class="lead">{service.introduction}</p><div class="actions"><a class="button button-primary" href="#contact">{vr ? 'Build a VR experience' : 'Discuss your project'} <span aria-hidden="true">&#8599;</span></a>{service.featuredProjects.length > 0 && <a class="button button-text" href="#service-work">{vr ? 'View our VR work' : 'View related work'} <span aria-hidden="true">&#8595;</span></a>}</div><p class="capability-line">{service.technologies.join(' \u00b7 ')}</p></div></section>
{(service.overviewCopy || service.useCases.length > 0) && <section class="outcomes" data-scene="layered">{service.overviewCopy && <div class="section-head"><div><p class="section-index">From concept to deployment</p><h2>{service.overviewHeading || `What does ${service.title.toLowerCase()} involve?`}</h2></div><p>{service.overviewCopy}</p></div>}{service.useCases.length > 0 && <><h2 class="subheading">What can we build?</h2><div class="outcome-grid">{service.useCases.map(item => <article><h3>{item.title}</h3><p>{item.description}</p></article>)}</div></>}</section>}
{service.capabilities.length > 0 && <section class="service-section" data-scene="spatial"><p class="section-index">Platforms and technologies</p><h2>Choose the platform around the experience.</h2><div class="platform-grid">{service.capabilities.map(item => <article><h3>{item.title}</h3><p>{item.description}</p></article>)}</div></section>}
{service.deliveryHeading && service.deliveryIntroduction && <section class="service-section" id="delivery" data-scene="layered" aria-labelledby="delivery-heading"><div class="section-head"><div><p class="section-index">Multidisciplinary delivery</p><h2 id="delivery-heading">{service.deliveryHeading}</h2></div><p>{service.deliveryIntroduction}</p></div>{service.deliveryApproach && <p class="lead">{service.deliveryApproach}</p>}{service.productionCapabilities.length > 0 && <><h3 class="production-heading">Skills we can bring together</h3><ul class="production-capabilities">{service.productionCapabilities.map(capability => <li>{capability}</li>)}</ul></>}<p class="supporting-copy">{settings.companyName} leads the team and takes responsibility for the client relationship, project direction and overall delivery. Strategy, technical direction and delivery stay connected from the first conversation through to launch.</p></section>}
{service.featuredProjects.length > 0 && <section class="work" id="service-work" data-scene="products"><div class="section-head"><div><p class="section-index">{vr ? 'Our VR work' : 'Related work'}</p><h2>{vr ? 'Built for spatial interaction.' : 'See the work.'}</h2></div>{service.workIntroduction && <p>{service.workIntroduction}</p>}</div><div class="project-grid project-grid-two">{service.featuredProjects.map(project => <ProjectCard project={project} />)}</div></section>}
{service.faqs.length > 0 && <section class="service-section buyer-questions" data-scene="process"><p class="section-index">Planning your project</p><h2>Before we build.</h2>{service.faqs.map(faq => <article><h3>{faq.question}</h3><p>{faq.answer}</p></article>)}<p><a class="inline-link" href="/#process">See how we discover, prototype and deliver projects</a></p></section>}
{service.related.length > 0 && <section class="service-section"><RelatedContent links={service.related} /></section>}
<ContactSection /></main></SiteLayout>
