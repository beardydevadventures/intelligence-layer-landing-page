---
import SiteLayout from '../layouts/SiteLayout.astro';
import SceneCanvas from '../components/experience/SceneCanvas.astro';
import ProductMockup from '../components/ProductMockup.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactSection from '../components/ContactSection.astro';
import {getContent} from '../lib/sanity/content';
import {pageSeo} from '../lib/sanity/seo';
import {defaultHomepage} from '../lib/sanity/defaults';
const {homepage, settings, services} = await getContent();
const heroWords = homepage.heroHeading.split(' ');
const heroStart = heroWords.slice(0,-3).join(' ');
const heroEnd = heroWords.slice(-3).join(' ');
const aiService = services.find(s => s.category === 'ai' && s.slug === 'ai-automation');
import { site } from '../data/site';
import { Search, PenTool, FlaskConical, Hammer, Plug, RefreshCw, Workflow, Cuboid, ScanSearch, ClipboardCheck, MessageSquare } from '@lucide/astro';
const steps = [ { label: 'Discover', detail: 'Understand the problem', icon: Search }, { label: 'Design', detail: 'Shape the experience or system', icon: PenTool }, { label: 'Prototype', detail: 'Validate the idea quickly', icon: FlaskConical }, { label: 'Build', detail: 'Create the production solution', icon: Hammer }, { label: 'Integrate', detail: 'Connect and deploy it safely', icon: Plug }, { label: 'Improve', detail: 'Measure, iterate and evolve', icon: RefreshCw } ];
const products = [{type:'cyber',icon:ScanSearch},{type:'cleaning',icon:ClipboardCheck},{type:'inlyr',icon:MessageSquare}] as const;
---
<SiteLayout {...pageSeo(homepage.seo, settings, undefined, undefined, '/')} schema={[{ '@type': 'WebSite', '@id': `${site.url}/#website`, url: `${site.url}/`, name: settings.companyName, publisher: { '@id': `${site.url}/#organisation` }, inLanguage: 'en-AU' }]}>
<SceneCanvas />
<main id="main">
<section class="hero section-grid" id="top" data-scene="hero"><div class="content content-wide"><p class="eyebrow"><span></span> {homepage.heroEyebrow}</p><h1>{heroStart} <em>{heroEnd}</em></h1><p class="lead">{homepage.heroIntroduction}</p><div class="actions"><a class="button button-primary" href={homepage.primaryCtaDestination}>{homepage.primaryCtaLabel} <span aria-hidden="true">&#8599;</span></a><a class="button button-text" href="#work">{homepage.secondaryCtaLabel} <span aria-hidden="true">&#8595;</span></a></div><p class="capability-line">AI Automation &middot; VR &middot; AR &middot; MR &middot; WebXR &middot; Digital Twins</p></div><p class="hero-note">{settings.locationDescription}<br />Working across Australia</p></section>
<section class="work" id="work" data-scene="products"><div class="section-head"><div><p class="section-index">01 / Selected work</p><h2>Ideas made<br />interactive.</h2></div><p>{homepage.workIntroduction}</p></div><div class="project-grid">{homepage.featuredProjects.map(project => <ProjectCard project={project} />)}</div></section>
<div class="capabilities-wrap">
<section class="capability section-grid" id="automation" data-scene="automation"><div class="content"><div class="capability-meta"><span class="icon-frame"><Workflow size={25} stroke-width={1.5} /></span><p class="cap-number">02 / AI & Automation</p></div><h2>{homepage.aiHeading}</h2><p>{homepage.aiIntroduction}</p><ul class="use-list">{homepage.aiCapabilities.map(item => <li>{item}</li>)}</ul><a href={aiService ? `/ai/${aiService.slug}/` : `mailto:${settings.contactEmail}?subject=AI%20automation%20project`}>Explore AI automation <span aria-hidden="true">&#8599;</span></a></div></section>
<section class="capability section-grid" id="spatial" data-scene="spatial"><div class="content"><div class="capability-meta"><span class="icon-frame"><Cuboid size={25} stroke-width={1.5} /></span><p class="cap-number">03 / XR & Spatial Computing</p></div><h2>{homepage.xrHeading}</h2><p>{homepage.xrIntroduction}</p><div class="xr-categories">{homepage.xrCategories.map(({title, description}) => <div><h3>{title}</h3><p>{description}</p></div>)}</div><a href="/xr/vr-development/">Explore XR development <span aria-hidden="true">&#8599;</span></a></div></section>
</div>
<section class="outcomes" id="build" data-scene="layered"><div class="section-head"><div><p class="section-index">04 / What we can build</p><h2>What could we<br />build together?</h2></div><p>{homepage.buildIntroduction}</p></div><div class="outcome-grid">{homepage.outcomes.map(({title, description}, i) => <article><p class="section-index">0{i + 1}</p><h3>{title}</h3><p>{description}</p></article>)}</div><p class="supporting-copy">Behind every experience: custom digital platforms, integrations, cloud systems, cybersecurity and product development.</p></section>
<section class="process" id="process" data-scene="process"><div class="section-head"><div><p class="section-index">05 / How we work</p><h2>From possibility<br />to practical.</h2></div><p>{homepage.processIntroduction}</p></div><ol class="process-steps">{steps.map((step, i) => { const Icon = step.icon; return <li><span>0{i + 1}</span><div class="process-node"><Icon size={27} stroke-width={1.45} /></div><strong>{step.label}</strong><small>{step.detail}</small></li>; })}</ol></section>
<section class="products" id="products" data-scene="products"><div class="section-head"><div><p class="section-index">06 / Products & Ventures</p><h2>We build our own.</h2></div><p>{homepage.productsIntroduction}</p></div><div class="product-list">{products.map((product, i) => { const Icon = product.icon; return <article class="product-card"><div class="product-copy"><span class="icon-frame icon-frame-dark"><Icon size={24} stroke-width={1.5} /></span><p class="product-num">0{i + 1}</p><h3>{homepage.ventures[i]?.title || defaultHomepage.ventures[i].title}</h3><p>{homepage.ventures[i]?.description || defaultHomepage.ventures[i].description}</p><small class="product-status">In development</small></div><ProductMockup type={product.type} /></article>; })}</div></section>
<ContactSection />
</main>
</SiteLayout>
