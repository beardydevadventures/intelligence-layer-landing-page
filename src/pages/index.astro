---
import SiteLayout from '../layouts/SiteLayout.astro';
import SceneCanvas from '../components/experience/SceneCanvas.astro';
import ProductMockup from '../components/ProductMockup.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProcessSection from '../components/ProcessSection.astro';
import ContactSection from '../components/ContactSection.astro';
import {getContent} from '../lib/sanity/content';
import {pageSeo} from '../lib/sanity/seo';
import {defaultHomepage} from '../lib/sanity/defaults';
import {site} from '../data/site';
import {ScanSearch, ClipboardCheck, MessageSquare} from '@lucide/astro';
const {homepage, settings, services, commercial, marketing} = await getContent();
const products = [{type:'cyber',icon:ScanSearch},{type:'cleaning',icon:ClipboardCheck},{type:'inlyr',icon:MessageSquare}] as const;
const offers = services.filter(s=>s.slug !== 'vr-development');
---
<SiteLayout {...pageSeo(homepage.seo,settings,undefined,undefined,'/')} schema={[{'@type':'WebSite','@id':`${site.url}/#website`,url:`${site.url}/`,name:settings.companyName,publisher:{'@id':`${site.url}/#organisation`},inLanguage:'en-AU'}]}>
<main id="main">
<section class="hero section-grid sales-hero" id="top"><SceneCanvas /><div class="content content-wide"><p class="eyebrow"><span></span>{homepage.heroEyebrow}</p><h1>{homepage.heroHeading}</h1><p class="lead">{homepage.heroIntroduction}</p><div class="actions"><a class="button button-primary" href={homepage.primaryCtaDestination === '#contact' ? '/start-a-project/' : homepage.primaryCtaDestination}>{homepage.primaryCtaLabel} <span aria-hidden="true">&#8599;</span></a><a class="button button-text" href="#work">{homepage.secondaryCtaLabel} <span aria-hidden="true">&#8595;</span></a></div><p class="capability-line">{marketing.homepageCapabilityLine}</p></div><p class="hero-note">{settings.locationDescription}<br />Working across Australia</p></section>
<section class="service-section" id="services"><span id="automation"></span><span id="spatial"></span><span id="build"></span><div class="section-head"><div><p class="section-index">01 / Core services</p><h2 class="marketing-heading">{marketing.homepageServicesHeading}</h2></div><p>{marketing.homepageServicesIntroduction}</p></div><div class="platform-grid">{offers.map(service=><article><h3><a href={`/${service.category}/${service.slug}/`}>{service.title}</a></h3><p>{service.shortDescription}</p><a class="inline-link" href={`/${service.category}/${service.slug}/`}>{marketing.exploreServiceLabel}</a></article>)}</div><p><a class="inline-link" href="/services/">{marketing.compareServicesLabel}</a> &middot; <a class="inline-link" href="/xr/vr-development/">{marketing.exploreVrLabel}</a></p></section>
<section class="service-section" id="industries"><div class="section-head"><div><p class="section-index">02 / Who we work with</p><h2 class="marketing-heading">{marketing.homepageIndustriesHeading}</h2></div><p>{marketing.homepageIndustriesIntroduction}</p></div><div class="industry-grid">{commercial.industries.map(industry=><article><h3 class="card-heading">{industry.title}</h3><p>{industry.description}</p></article>)}</div><p class="process-action"><a class="inline-link" href="/industries/">{marketing.exploreIndustriesLabel}</a></p></section>
<ProcessSection />
<section class="work" id="work"><div class="section-head"><div><p class="section-index">04 / Selected work</p><h2 class="marketing-heading">{marketing.homepageWorkHeading}</h2></div><p>{homepage.workIntroduction}</p></div><div class="project-grid">{homepage.featuredProjects.map(project=><ProjectCard project={project} />)}</div><p class="process-action"><a class="inline-link" href="/work/">{marketing.viewWorkLabel}</a></p></section>
<section class="service-section" id="credibility"><p class="section-index">05 / Connected delivery</p><h2 class="marketing-heading">{marketing.homepageCredibilityHeading}</h2><p class="lead">{commercial.about.delivery}</p><p><a class="inline-link" href="/about/">{marketing.aboutLinkLabel}</a></p></section>
<section class="products" id="products" data-scene="products"><div class="section-head"><div><p class="section-index">06 / Products & Ventures</p><h2 class="marketing-heading">{marketing.homepageProductsHeading}</h2></div><p>{homepage.productsIntroduction}</p></div><div class="product-list">{products.map((product, i) => { const Icon = product.icon; return <article class="product-card"><div class="product-copy"><span class="icon-frame icon-frame-dark"><Icon size={24} stroke-width={1.5} /></span><p class="product-num">0{i + 1}</p><h3>{homepage.ventures[i]?.title || defaultHomepage.ventures[i].title}</h3><p>{homepage.ventures[i]?.description || defaultHomepage.ventures[i].description}</p><small class="product-status">In development</small></div><ProductMockup type={product.type} /></article>; })}</div></section>
<ContactSection /></main></SiteLayout>
