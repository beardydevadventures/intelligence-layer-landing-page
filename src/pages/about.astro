---
import SiteLayout from '../layouts/SiteLayout.astro';
import ContactSection from '../components/ContactSection.astro';
import EditorialImage from '../components/EditorialImage.astro';
import {getContent} from '../lib/sanity/content';
const {commercial, settings} = await getContent();
---
<SiteLayout title="About Intelligence Layer | Brisbane AI & XR Studio" description={commercial.about.introduction}><main id="main"><header class="editorial-header"><p class="eyebrow">About / {settings.locationDescription}</p><h1>{commercial.about.title}</h1><p class="lead">{commercial.about.introduction}</p></header><section class="editorial-body"><h2>Accountability from first conversation to delivery.</h2><p>{commercial.about.delivery}</p><h2>See what we build.</h2><p>{commercial.about.evidence}</p><p><a class="inline-link" href="/work/">Explore our work</a> · <a class="inline-link" href="/services/">Explore our services</a></p>{commercial.team.length > 0 && <><h2>Meet the team</h2><div class="industry-grid">{commercial.team.map(person=><article>{person.image && <EditorialImage image={person.image} />}<h3>{person.name}</h3><p><strong>{person.role}</strong></p><p>{person.biography}</p></article>)}</div></>}</section><ContactSection /></main></SiteLayout>
