---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ContactSection from '../../components/ContactSection.astro';
import {getContent} from '../../lib/sanity/content';
const {services,marketing} = await getContent();
---
<SiteLayout title="AI, XR & Digital Twin Services | Intelligence Layer" description="Explore AI automation, enterprise AI agents, immersive experiences and digital twins from Intelligence Layer in Brisbane, Australia."><main id="main"><header class="editorial-header"><p class="eyebrow">Services</p><h1>{marketing.servicesHeading}</h1><p class="lead">{marketing.servicesIntroduction}</p></header><section class="service-section"><div class="outcome-grid">{services.map(service => <article><h2 class="card-heading"><a href={`/${service.category}/${service.slug}/`}>{service.title}</a></h2><p>{service.shortDescription}</p><a class="inline-link" href={`/${service.category}/${service.slug}/`}>Explore {service.title}</a></article>)}</div></section><ContactSection /></main></SiteLayout>
