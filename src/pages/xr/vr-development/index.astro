---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SceneCanvas from '../../../components/experience/SceneCanvas.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import ContactSection from '../../../components/ContactSection.astro';
import { projects } from '../../../data/projects';
import { site } from '../../../data/site';
const productionCapabilities = ['XR and Unity development', 'Interaction design', 'Technical architecture', '3D environments and assets', 'Character production', 'Animation', 'VFX', 'Motion capture', 'UI and spatial interface design', 'Audio and media production', 'Backend and system integrations'];
const uses = [ ['VR training', 'Practise procedures and decision-making in a controlled virtual environment.'], ['Interactive simulations', 'Explore scenarios and systems through hands-on interaction.'], ['Product visualisation', 'Experience scale, form and function in three dimensions.'], ['Immersive storytelling', 'Bring places and narratives into an interactive environment.'], ['Trade show experiences', 'Give visitors a focused experience of your product or idea.'], ['Digital twins', 'Explore a spatial representation of a facility or environment.'], ['Education', 'Make concepts tangible through guided exploration.'], ['Games and entertainment', 'Create VR-native play and spatial interaction.'], ['Location-based VR', 'Scope experiences around a physical venue and its operating requirements.'], ['Prototype experiences', 'Test the core interaction before investing in a full application.'] ];
const questions = [
 ['How much does VR development cost in Australia?', 'VR development cost depends on interaction complexity, the quantity and quality of 3D content, the number of environments and the target hardware. Integrations, multiplayer or networking, backend systems, testing and deployment also affect the scope. A focused prototype is considerably less expensive than a production-grade training platform or a large multi-environment experience. We define the scope with you before estimating the work.'],
 ['How long does it take to build a VR experience?', 'A focused VR prototype may take weeks, while larger production applications can take multiple months. Content creation, interaction design, integrations and testing all influence the timeline. Discovery establishes a delivery plan around the actual scope rather than a fixed promise.'],
 ['Can you build VR applications for Meta Quest?', 'Yes. Diamond Easy is a native immersive crafting experience designed for Meta Quest. For a new application, we establish the target headset, interaction requirements and deployment approach during discovery.'],
 ['Can VR integrate with existing systems?', 'Yes. A VR application can connect to existing systems through APIs and backend services, for example to retrieve content or record training activity. We assess authentication, data handling, connectivity and the available interfaces before defining the integration.'],
 ['Do we own the application?', 'Application ownership, source code access and licensing are determined in the project agreement. We clarify these arrangements before work begins, including any third-party assets or platform dependencies.'],
 ['Do you provide hardware?', 'Hardware selection and procurement requirements are discussed during discovery. We can help identify appropriate headsets and plan deployment requirements; hardware supply and purchasing responsibilities must be agreed for the project.'],
 ['What is the difference between VR, AR and mixed reality?', 'Virtual reality places people inside a digital environment. Augmented reality places digital information into a view of the real world. Mixed reality lets digital content interact with the physical environment. The appropriate approach depends on the task, audience and setting.'],
];
---
<SiteLayout title="VR Development Brisbane & Australia | Intelligence Layer" description="Intelligence Layer designs and develops custom VR experiences, Meta Quest applications, immersive training, simulations and spatial software for organisations across Brisbane and Australia." schema={[{ '@type': 'Service', '@id': `${site.url}/xr/vr-development/#service`, name: 'Custom Virtual Reality Development', serviceType: 'Virtual reality development', description: 'Custom VR experiences, Meta Quest applications, immersive training, simulations and spatial software.', provider: { '@id': `${site.url}/#organisation` }, areaServed: { '@type': 'Country', name: 'Australia' }, url: `${site.url}/xr/vr-development/` }, { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` }, { '@type': 'ListItem', position: 2, name: 'VR Development', item: `${site.url}/xr/vr-development/` }] }]}>
<SceneCanvas /><main id="main" class="service-page">
<section class="hero section-grid" id="top" data-scene="spatial"><div class="content content-wide"><p class="eyebrow"><a href="/">Home</a> / XR / VR Development</p><h1>Custom Virtual Reality <em>Development</em></h1><p class="lead">Intelligence Layer designs and develops custom virtual reality experiences for organisations across Brisbane and Australia. From Meta Quest applications and immersive training to interactive simulations, visualisation and branded VR experiences, we take projects from early concept through to deployment.</p><div class="actions"><a class="button button-primary" href="#contact">Build a VR experience <span aria-hidden="true">&#8599;</span></a><a class="button button-text" href="#vr-work">View our VR work <span aria-hidden="true">&#8595;</span></a></div><p class="capability-line">Meta Quest &middot; PC VR &middot; Hand Tracking &middot; Mixed Reality &middot; Unity &middot; WebXR</p></div></section>
<section class="outcomes" data-scene="layered"><div class="section-head"><div><p class="section-index">01 / From concept to deployment</p><h2>What does a VR development company do?</h2></div><p>We shape the experience, design interactions, build the application and test it for the intended environment. Discovery connects your objectives with a practical plan for content, hardware and deployment.</p></div><h2 class="subheading">What can we build?</h2><div class="outcome-grid">{uses.map(([title, copy]) => <article><h3>{title}</h3><p>{copy}</p></article>)}</div></section>
<section class="service-section" data-scene="spatial"><p class="section-index">02 / Platforms and technologies</p><h2>Choose the platform around the experience.</h2><div class="platform-grid"><article><h3>Meta Quest & Unity</h3><p>Diamond Easy demonstrates our Meta Quest and Unity work. For new projects, we evaluate standalone headset requirements, including Quest 3 or Quest 3S where appropriate, and test against the agreed devices.</p></article><article><h3>PC VR & SteamVR</h3><p>PC VR may suit experiences with demanding visual or computing requirements. SteamVR compatibility and specific hardware support are scoped and validated for each project.</p></article><article><h3>WebXR</h3><p>Browser-based spatial experiences can reach people on desktop, mobile and compatible headsets. Browser and device capabilities determine the available interactions.</p></article><article><h3>Natural interaction</h3><p>Hand tracking, controller-based interaction and mixed reality each suit different tasks. We prototype the appropriate approach and confirm support on the target hardware.</p></article></div></section>
<section class="service-section" id="delivery" data-scene="layered" aria-labelledby="delivery-heading">
  <div class="section-head"><div><p class="section-index">03 / Multidisciplinary delivery</p><h2 id="delivery-heading">Built by the right team for the experience.</h2></div><p>Immersive projects often combine software development, interaction design and specialist content production. We build the team around the experience, bringing together the technical and creative skills required to take a project from concept through to deployment.</p></div>
  <p class="lead">From focused prototypes to multidisciplinary immersive projects, we build the team and delivery approach around what the experience actually requires.</p>
  <h3 class="production-heading">Skills we can bring together</h3>
  <ul class="production-capabilities">{productionCapabilities.map(capability => <li>{capability}</li>)}</ul>
  <p class="supporting-copy">Intelligence Layer leads the team and takes responsibility for the client relationship, project direction and overall delivery. Strategy, technical direction and delivery stay connected from the first conversation through to launch.</p>
</section>
<section class="work" id="vr-work" data-scene="products"><div class="section-head"><div><p class="section-index">04 / Our VR work</p><h2>Built for spatial interaction.</h2></div><p>Diamond Easy brings crafting into Meta Quest. Our independent Brisbane digital twin concept explores access across the web and VR.</p></div><div class="project-grid project-grid-two">{projects.filter(p => p.platform.includes('Meta Quest') || p.platform.includes('VR')).map(project => <ProjectCard project={project} />)}</div></section>
<section class="service-section buyer-questions" data-scene="process"><p class="section-index">05 / Planning your project</p><h2>Before we build.</h2>{questions.map(([question, answer]) => <article><h3>{question}</h3><p>{answer}</p></article>)}<p><a class="inline-link" href="/#process">See how we discover, prototype and deliver projects</a></p></section>
<ContactSection /></main></SiteLayout>
