# Copy to .env locally; add the same names to the build host environment.
SANITY_PROJECT_ID=gr23tee8
SANITY_DATASET=production
# Optional build-only read token for a private dataset. Never use a write token.
SANITY_API_READ_TOKEN=
# Public Studio identifiers; use the same project/dataset as above.
SANITY_STUDIO_PROJECT_ID=gr23tee8
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_PUBLIC_SITE_URL=https://intelligencelayer.com.au
# Local setup only; secret Workers Builds hook URL. Never set as a Studio/PUBLIC variable.
CLOUDFLARE_DEPLOY_HOOK_URL=
